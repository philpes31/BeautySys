{
  "redirects": [
    {
      "source": "/saas/",
      "destination": "/saas",
      "permanent": false
    },
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "beautysys.vercel.app"
        }
      ],
      "destination": "https://www.agendio.tec.br/$1",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 10 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/wa-conectar",
      "destination": "/api/x?a=wa-conectar"
    },
    {
      "source": "/api/wa-config",
      "destination": "/api/x?a=wa-config"
    },
    {
      "source": "/api/wa-signup",
      "destination": "/api/x?a=wa-signup"
    },
    {
      "source": "/api/email-teste",
      "destination": "/api/x?a=email-teste"
    },
    {
      "source": "/api/mp-config",
      "destination": "/api/x?a=mp-config"
    },
    {
      "source": "/api/mp-conectar",
      "destination": "/api/x?a=mp-conectar"
    },
    {
      "source": "/api/push-teste",
      "destination": "/api/x?a=push-teste"
    },
    {
      "source": "/api/push-enviar",
      "destination": "/api/x?a=push-enviar"
    },
    {
      "source": "/api/push-chave",
      "destination": "/api/x?a=push-chave"
    },
    {
      "source": "/",
      "destination": "/divulgacao.html"
    },
    {
      "source": "/saas",
      "destination": "/saas.html"
    },
    {
      "source": "/a/:slug",
      "destination": "/agendar.html"
    },
    {
      "source": "/divulgacao",
      "destination": "/divulgacao.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!a/|agendar\\.html).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://connect.facebook.net https://sdk.mercadopago.com https://*.mlstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.facebook.com https://*.facebook.net https://*.supabase.co wss://*.supabase.co https://*.mercadopago.com https://*.mercadolibre.com https://*.mlstatic.com; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'; frame-src 'self' https://*.facebook.com https://*.mercadopago.com https://*.mercadolibre.com https://*.mlstatic.com"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/(a/.*|agendar\\.html)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://sdk.mercadopago.com https://*.mlstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.mercadopago.com https://*.mercadolibre.com https://*.mlstatic.com; base-uri 'self'; object-src 'none'; form-action 'self'; frame-src 'self' https://*.mercadopago.com https://*.mercadolibre.com https://*.mlstatic.com"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "Content-Type",
          "value": "text/javascript; charset=utf-8"
        }
      ]
    }
  ]
}